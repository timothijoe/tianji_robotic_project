<?xml version="1.0"?>
<package format="3">
  <name>twin_wuji_sim</name>
  <version>0.1.0</version>
  <description>ROS 2 bridge for the MuJoCo Wuji left hand.</description>
  <maintainer email="dev@example.com">Tianji Robotics</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_python</buildtool_depend>
